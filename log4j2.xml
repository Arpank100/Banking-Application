<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="info" monitorInterval="30">
	<Appenders>

		<RollingFile name="roll-by-time-and-size"
			fileName="${env:LOG_BASE_DIR}/getepro2.0/getepro2.0.log"
			filePattern="${env:LOG_BASE_DIR}/getepro2.0/getepro2.0.%d{dd-MMM-yyyy}.%i.log"
			ignoreExceptions="false">
			<PatternLayout>
				<!-- <Pattern>%d{yyyy-MM-dd HH:mm:ss} %p %m%n</Pattern> -->
				<Pattern>%d{yyyy-MM-dd HH:mm:ss} %X{messageId} %C{1}.%L %p %m%n</Pattern>

			</PatternLayout>
			<Policies>
				<OnStartupTriggeringPolicy />
				<SizeBasedTriggeringPolicy size="10 MB" />
				<TimeBasedTriggeringPolicy />
			</Policies>
			<DefaultRolloverStrategy fileIndex="nomax">

			</DefaultRolloverStrategy>
		</RollingFile>

	</Appenders>
	<Loggers>
		<AsyncRoot level="info" includeLocation="true">
			<AppenderRef ref="roll-by-time-and-size" />
		</AsyncRoot>
	</Loggers>
</Configuration>